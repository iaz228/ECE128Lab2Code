`timescale 1ns / 1ps

module tb_CarryLookAheadAdder_4bit;

    reg  [3:0] a, b;
    reg c_in;
    wire [3:0] s;
    wire c_out;

    CarryLookAheadAdder_4bit uut ( .a(a), .b(b), .c_in(c_in), .s(s), .c_out(c_out));

    initial begin
 
        $monitor("Time=%0t | a=%d b=%d c_in=%b -> c_out=%b s=%d", $time, a, b, c_in, c_out, s);

        // Apply test inputs
        a = 0;  b = 0;  c_in = 0; #10;
        a = 5;  b = 3;  c_in = 0; #10;
        a = 10; b = 7;  c_in = 0; #10; // Result: 17 (c_out=1, s=1)
        a = 15; b = 15; c_in = 1; #10; // Max values: 31 (c_out=1, s=15)

        $finish;
    end

endmodule
