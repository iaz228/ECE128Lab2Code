`timescale 1ns / 1ps

module FA_tb;

    // Inputs (reg) and Outputs (wire)
    reg a, b, c_in;
    wire c_out, s;

    FA uut (
        .a(a), 
        .b(b), 
        .c_in(c_in), 
        .c_out(c_out), 
        .s(s)
    );

    initial begin
   
        $monitor("Time = %0t | a=%b b=%b c_in=%b -> s=%b c_out=%b", $time, a, b, c_in, s, c_out);


        a=0; b=0; c_in=0; #10;
        a=0; b=0; c_in=1; #10;
        a=0; b=1; c_in=0; #10;
        a=0; b=1; c_in=1; #10;
        a=1; b=0; c_in=0; #10;
        a=1; b=0; c_in=1; #10;
        a=1; b=1; c_in=0; #10;
        a=1; b=1; c_in=1; #10;

        $finish;
    end

endmodule
